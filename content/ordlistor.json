 "meta": {
  "version": "0.13",
  "datum": "2026-11-12",
  "agare": "Innehåll",
  "textform": "Orden lagras med små bokstäver, formler i versaler. Böjda former (skogen, bron) står med när de används som alternativ.",
  "beskrivning": "Ordlistor 1-6 for ORDSTAVEN. Bilderna ar platshallare (emoji) for grabox. Ett ord ligger i den hogsta lista som nagot av dess drag kraver.",
  "bilder": "Emoji är platshållare. Där emojin är missvisande står ett bild-id i stället (filt).",
  "andrat_v05": "bok och farfar tillagda (prologen v0.11, hallens dörrar).",
  "andrat_v06": "skolan (prologen v0.11.3, vägskylten), och var, vid, bakom, väntar, busken och skata (kapitel 1 v0.7.4: skylten vid ingången och baronens lapp). Granskningen A 25: varje ord i en lästext ska finnas i ordlistorna.",
  "andrat_v07": "80 ordformer från uppdragslappen (beslut 40.1), så att lappens text står i ordlistorna. Listan följer listornas regler: dubbelteckning ger lista 4, konsonantgrupp i början lista 3, korta ljudenliga ord lista 1 och längre lista 2. ATT, DIG, FÖR och UPP är småord som lärs som ordbilder (lista 6). KARTBITEN, LIANERNA och BARONENS är berättelseord.",
  "andrat_v08": "13 ordformer som står i lästexter men saknades (Tekniks kontroll i 0.22.0, beslut 43.5): stora, höga, runda, gamla, vita och gula (böjda egenskapsord), stenen, dalens, dinos, fötter och fossil, man och klättrar. Ingen lästext är omskriven, eftersom texterna är spelade och rummen frysta. Listan följer reglerna: dubbelteckning lista 4 (fossil, klättrar, fötter), konsonantgrupp i början lista 3 (stora, stenen), man lista 1 och resten lista 2.",
  "andrat_v09": "vems (rubriken VEMS LAPP? i kapitel 1, det korta passet). Konsonantgrupp i slutet, alltså lista 2.",
  "andrat_v010": "Kapitel 2 (beslut 64): orden i lästexten, uppdragens rubriker, ord han troligen skriver på tangentbordet (tema skrivord, så att de aldrig får pff, 63.3) och bybornas bubblor.",
  "andrat_v011": "Kapitel 2 (beslut 71.6): sax, kniv, hugg och lys, ord han troligen skriver vid vassen och lyktorna (tema skrivord, så att de aldrig får pff). HUGG och LYS står också på uppdragslappen.",
  "andrat_v012": "Beslut 76.6 (granskning 5, C6): vad (stumt D), sov och kom (O som Å) är inte ljudenliga och står nu i lista 6 som ordbilder. Låg, hel och torr (skyltarna i L4, 76.4).",
  "andrat_v013": "vän, bor, litet och dörren (kapitel 2, beslut 77.4)."
 },
 "listor": {
  "1": "Korta ljudenliga ord, 2-3 bokstaver, ingen konsonantgrupp, ingen dubbelteckning",
  "2": "Langre ljudenliga ord (4-6 bokstaver) eller konsonantgrupp i slutet",
  "3": "Konsonantgrupp i borjan",
  "4": "Kort vokal med dubbelteckning (aven CK)",
  "5": "Svara ljud (LJ, sj, tj, NG, mjukt G/K). Sparrade i lastext utom formler med forebild",
  "6": "Smaord som ordbilder"
 },
