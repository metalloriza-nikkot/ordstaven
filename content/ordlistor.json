  "helord": "Lases upp som helt ord, aldrig ljudat bokstav for bokstav",
  "sparrad": "Far inte forekomma i text spelaren laser sjalv annu",
  "berattelseord": "Far forekomma tidigt som ordbild trots listan",
  "formel": "Trollformel, lars med forebild (S1)",
  "ordbild": "Smaord som lars som helhet"
 },
